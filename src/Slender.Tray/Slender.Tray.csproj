<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Slender.Engine\Slender.Engine.csproj" />
    <ProjectReference Include="..\Slender.Hidpp\Slender.Hidpp.csproj" />
    <ProjectReference Include="..\Slender.Sync\Slender.Sync.csproj" />
    <ProjectReference Include="..\Slender.Yealink\Slender.Yealink.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Velopack" Version="1.2.161" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>false</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <IsAotCompatible>true</IsAotCompatible>
    <ApplicationIcon>slender.ico</ApplicationIcon>
    <!-- NativeAOT: `dotnet publish -r win-x64 -p:PublishAot=true`. Opt-in on the command line so plain builds and tests stay JIT. -->
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <UseSystemResourceKeys>true</UseSystemResourceKeys>
  </PropertyGroup>

  <ItemGroup>
    <!-- The ring overlay draws Sora and JetBrains Mono from Assets\Fonts next to the exe (the same files the settings app ships); without them it falls back to Segoe UI Variable and Consolas. -->
    <Content Include="..\Slender.Settings\Assets\Fonts\Sora-SemiBold.ttf" Link="Assets\Fonts\Sora-SemiBold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\Slender.Settings\Assets\Fonts\JetBrainsMono-Medium.ttf" Link="Assets\Fonts\JetBrainsMono-Medium.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ring sounds are read from Assets\Sounds next to the exe; the installer puts Settings and the tray in one folder, and this gives a dev build of the tray the same files. -->
    <Content Include="..\Slender.Settings\Assets\Sounds\*.wav" Link="Assets\Sounds\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup Condition="'$(SlenderUpdateSource)' != ''">
    <!-- Build-Setup.ps1 passes -p:SlenderUpdateSource=<artifactseleases>: the default update source baked into this build (slender.sync.json still overrides). -->
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>SlenderUpdateSource</_Parameter1>
      <_Parameter2>$(SlenderUpdateSource)</_Parameter2>
    </AssemblyAttribute>
  </ItemGroup>

  <ItemGroup>
    <!-- Cap the gen0 budget: tray keeps ~0.6 MB live but reserves ~20 MB of GC space otherwise (docs/memory.md #2).
         For NativeAOT this item is baked into the executable (runtimeconfig knobs are compiled in), so it applies there too. -->
    <RuntimeHostConfigurationOption Include="System.GC.Gen0MaxBudget" Value="1048576" />
  </ItemGroup>

</Project>
