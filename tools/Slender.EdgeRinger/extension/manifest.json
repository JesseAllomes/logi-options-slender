{
  "manifest_version": 3,
  "name": "Slender 3CX ringer",
  "version": "1.0.0",
  "description": "Tells Slender when a 3CX call starts and stops ringing. Sends no call details.",
  "key": "",
  "minimum_chrome_version": "111",
  "permissions": ["nativeMessaging"],
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    {
      "matches": ["__ORIGIN__/*"],
      "js": ["main.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["__ORIGIN__/*"],
      "js": ["relay.js"],
      "run_at": "document_start"
    }
  ]
}
