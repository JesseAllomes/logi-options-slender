<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <IsPackable>false</IsPackable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <!-- Sanitised Options+ settings.db / macros.db JSON blobs for the importer tests. -->
    <None Update="Fixtures\*.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Sanitised Logi Plugin Service store (Applications\Loupedeck72\...) for the Actions Ring importer tests. -->
    <None Update="Fixtures\pluginservice\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <!-- The same two fonts the tray ships, so the bundled-fonts test checks real files. -->
    <None Include="..\..\src\Slender.Settings\Assets\Fonts\Sora-SemiBold.ttf" Link="Assets\Fonts\Sora-SemiBold.ttf" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\..\src\Slender.Settings\Assets\Fonts\JetBrainsMono-Medium.ttf" Link="Assets\Fonts\JetBrainsMono-Medium.ttf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pure settings logic (no WinUI types) is compiled into the tests directly; the WinUI project itself is not referenced. -->
    <Compile Include="..\..\src\Slender.Settings\Logic\*.cs" Link="Settings\Logic\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Slender.Tray\Slender.Tray.csproj" />
    <ProjectReference Include="..\..\src\Slender.Hidpp\Slender.Hidpp.csproj" />
    <ProjectReference Include="..\..\src\Slender.Engine\Slender.Engine.csproj" />
    <ProjectReference Include="..\..\src\Slender.Sync\Slender.Sync.csproj" />
</ItemGroup>

</Project>